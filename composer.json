{
    "name": "dept-of-scrapyard-robotics/adxl34x",
    "description": "Drive ADXL343 & ADXL345 three-axis accelerometers over I2C or SPI with the ScrapyardIO GPIO framework.",
    "type": "library",
    "version": "0.10.0",
    "keywords": [
        "adxl343",
        "adxl345",
        "accelerometer",
        "i2c",
        "spi",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "gpio/contracts": "^0.10.0",
        "gpio/integrated-circuits": "^0.10.0",
        "gpio/nuts-and-bolts": "^0.10.0",
        "venusian-voyager/contracts": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "require-dev": {
        "gpio/digital": "^0.10.0",
        "gpio/i2c": "^0.10.0",
        "gpio/spi": "^0.10.0",
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.10.0",
        "venusian-voyager/io-pools": "^0.10.0"
    },
    "suggest": {
        "gpio/digital": "^0.10.0 - INT1 / INT2 interrupt pins",
        "gpio/i2c": "^0.10.0 - I2C connections for ADXL34xI2CTransport",
        "gpio/spi": "^0.10.0 - SPI connections for ADXL34xSPITransport",
        "venusian-voyager/io-pools": "^0.10.0 - the event loop interrupts()->every() runs on",
        "microscrap/scrapyard-linux": "^0.10.0 - native i2c-dev, spidev and libgpiod drivers",
        "microscrap/scrapyard-usb": "^0.10.0 - MPSSE I2C, SPI and pins over FTDI"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Sensors\\ADXL34x\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Sensors\\ADXL34x\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "DeptOfScrapyardRobotics\\Sensors\\ADXL34x\\Providers\\ADXL34xServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
